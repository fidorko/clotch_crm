
# Postgres-хостинг (Supabase, спільна база для всіх ПК розробки — Session pooler, IPv4-сумісний)
# Реальні значення — Supabase Dashboard → Project Settings → Database → Connection string → Session pooler

# Власник схеми — використовується для міграцій (drizzle-kit) і сіда
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Non-owner роль застосунку — під неї діють RLS-політики (див. docs/db.md)
APP_DATABASE_URL=postgresql://app_user.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Локальний Postgres (docker-compose.yml) — офлайн-фолбек, не використовується за замовчуванням.
# Розкоментувати й підставити свої значення, якщо треба піднімати БД локально.
# POSTGRES_USER=clotch
# POSTGRES_PASSWORD=dev_only_change_me
# POSTGRES_DB=clotch_crm
# POSTGRES_PORT=5432

# TODO(auth): тимчасовий dev-тенант, доки нема сесій — див. src/server/tenant/get-tenant-id.ts
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001